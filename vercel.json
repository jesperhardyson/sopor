{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["arn1"],
  "buildCommand": "npm test && npm run build",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in dependabot/*) exit 0;; *) exit 1;; esac",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!api/|ics/|data/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-9irbkeVYfs/edWz7ZVGYKEQNu4c6NJT2PZTRR4iNhCQ=' 'sha256-5cxv8XCOhmhcKbZCumtEySiSUb/XQCsYIZXeA3sMzX8='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/((?!kommuner/|api/|ics/|data/|assets/)[^/]+/[^/]+)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ics/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/api/v1/openapi.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/kommuner",
      "destination": "/kommuner/index.html"
    },
    {
      "source": "/kommuner/:slug",
      "destination": "/kommuner/:slug/index.html"
    },
    {
      "source": "/ics/:source/:file",
      "destination": "/api/ics?source=:source&file=:file"
    },
    {
      "source": "/ics/:source/:reminder/:file",
      "destination": "/api/ics?source=:source&reminder=:reminder&file=:file"
    },
    {
      "source": "/api/v1/adress/:source/:id",
      "destination": "/api/v1/adress?source=:source&id=:id"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1/okand"
    },
    {
      "source": "/((?!data/|ics/|assets/|api/|kommuner/).*)",
      "destination": "/index.html"
    }
  ]
}
