  "version": "1.3.0",
  "description": "Sopor som Homey-app: sophämtning per adress i flöden",
  "license": "MIT",
  "type": "module",
  "main": "app.mjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
