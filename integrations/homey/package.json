    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "package-json": "^7.0.0",
    "sharp": "^0.35.5",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1"
