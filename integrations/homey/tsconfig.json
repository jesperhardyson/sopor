{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": ".homeybuild/",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "homey"]
  },
  "include": ["**/*.mts"],
  "exclude": ["node_modules", ".homeybuild", "**/*.test.mts"]
}
