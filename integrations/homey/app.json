{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "se.hardyson.sopor",
  "version": "0.1.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Waste Collection",
    "sv": "Sophämtning"
  },
  "description": {
    "en": "Waste collection days for your Swedish address, in your flows. Data from sopor.hardyson.se",
    "sv": "Sophämtningen för din adress, i dina flöden. Data från sopor.hardyson.se"
  },
  "category": "tools",
  "permissions": [],
  "brandColor": "#157A46",
  "author": {
    "name": "Jesper Hardyson",
    "email": "jesper@hardyson.se"
  },
  "homepage": "https://sopor.hardyson.se",
  "support": "https://github.com/jesperhardyson/sopor/issues",
  "source": "https://github.com/jesperhardyson/sopor/tree/main/integrations/homey",
  "bugs": {
    "url": "https://github.com/jesperhardyson/sopor/issues"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "esm": true,
  "flow": {
    "conditions": [
      {
        "id": "hamtas",
        "title": {
          "en": "Waste is !{{|not}} collected",
          "sv": "Sopor hämtas !{{|inte}}"
        },
        "titleFormatted": {
          "en": "[[fraktion]] is !{{|not}} collected [[nar]]",
          "sv": "[[fraktion]] hämtas !{{|inte}} [[nar]]"
        },
        "hint": {
          "en": "Checks the collection schedule for this address. Use it after a time card, for example at 19:00, to get a reminder the evening before.",
          "sv": "Kollar hämtschemat för den här adressen. Använd det efter ett tidskort, till exempel kl. 19:00, för en påminnelse kvällen innan."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=adress"
          },
          {
            "name": "fraktion",
            "type": "autocomplete",
            "title": {
              "en": "Fraction",
              "sv": "Fraktion"
            },
            "placeholder": {
              "en": "Any fraction",
              "sv": "Någon fraktion"
            }
          },
          {
            "name": "nar",
            "type": "dropdown",
            "title": {
              "en": "When",
              "sv": "När"
            },
            "values": [
              {
                "id": "0",
                "label": {
                  "en": "today",
                  "sv": "i dag"
                }
              },
              {
                "id": "1",
                "label": {
                  "en": "tomorrow",
                  "sv": "i morgon"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "the day after tomorrow",
                  "sv": "i övermorgon"
                }
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "uppdatera",
        "title": {
          "en": "Update the collection schedule",
          "sv": "Uppdatera hämtschemat"
        },
        "hint": {
          "en": "Fetches the schedule from Sopor right away. It is otherwise updated automatically.",
          "sv": "Hämtar schemat från Sopor direkt. Annars uppdateras det automatiskt."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=adress"
          }
        ]
      },
      {
        "id": "vad_hamtas",
        "title": {
          "en": "What waste is collected?",
          "sv": "Vilka sopor hämtas?"
        },
        "titleFormatted": {
          "en": "What waste is collected [[nar]]?",
          "sv": "Vilka sopor hämtas [[nar]]?"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=adress"
          },
          {
            "name": "nar",
            "type": "dropdown",
            "title": {
              "en": "When",
              "sv": "När"
            },
            "values": [
              {
                "id": "0",
                "label": {
                  "en": "today",
                  "sv": "i dag"
                }
              },
              {
                "id": "1",
                "label": {
                  "en": "tomorrow",
                  "sv": "i morgon"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "the day after tomorrow",
                  "sv": "i övermorgon"
                }
              }
            ]
          }
        ],
        "tokens": [
          {
            "name": "fraktioner",
            "type": "string",
            "title": {
              "en": "Fractions",
              "sv": "Fraktioner"
            },
            "example": {
              "en": "Plastic packaging, Metal",
              "sv": "Plastförpackningar, Metall"
            }
          },
          {
            "name": "antal",
            "type": "number",
            "title": {
              "en": "Number of fractions",
              "sv": "Antal fraktioner"
            },
            "example": 2
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Address",
        "sv": "Adress"
      },
      "class": "other",
      "capabilities": [
        "sopor_summary"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "pair": [
        {
          "id": "sok",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "prev": "sok",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/adress/assets/images/small.png",
        "large": "/drivers/adress/assets/images/large.png",
        "xlarge": "/drivers/adress/assets/images/xlarge.png"
      },
      "id": "adress"
    }
  ],
  "capabilities": {
    "sopor_next": {
      "type": "string",
      "title": {
        "en": "Collection",
        "sv": "Hämtning"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/karl.svg",
      "insights": false
    },
    "sopor_summary": {
      "type": "string",
      "title": {
        "en": "Next collection",
        "sv": "Nästa hämtning"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg",
      "insights": false
    }
  }
}